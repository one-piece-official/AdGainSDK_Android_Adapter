<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/et_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入媒体位后再选择广告类型"
        android:inputType="textEmailSubject"
        android:layout_marginBottom="20dp"/>


    <Button
        android:id="@+id/btn_splash2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开屏广告（全屏）"/>

    <Button
        android:id="@+id/btn_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Banner"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btn_flow_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="信息流(RecyclerView)"
        android:textAllCaps="false"/>


    <Button
        android:id="@+id/btn_insert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="插屏广告"
        android:textAllCaps="false"/>


    <Button
        android:id="@+id/btn_mix_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="原生混合"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btn_reward_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="激励视频"
        android:textAllCaps="false"/>



</LinearLayout>
</ScrollView>