<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/privacy_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000">

        <WebView
            android:id="@+id/privacy_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="120dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_alignLeft="@+id/privacy_webview"
            android:layout_alignRight="@+id/privacy_webview"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="63dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/privaty_no_agree"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/admate_text_button"
                android:textSize="18sp"
                android:textColor="@android:color/holo_blue_bright"
                android:gravity="center"
                android:text="不同意" />

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/privaty_agree"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/admate_text_button"
                android:textSize="18sp"
                android:textColor="@android:color/holo_blue_bright"
                android:gravity="center"
                android:text="同意" />

        </LinearLayout>

    </RelativeLayout>
</LinearLayout>